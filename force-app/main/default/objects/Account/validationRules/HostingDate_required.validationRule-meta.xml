<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>HostingDate_required</fullName>
    <active>true</active>
    <errorConditionFormula
  >ISPICKVAL(Hosting_Country__c, &quot;USA&quot;) &amp;&amp; ISBLANK(Hosting_Date__c)</errorConditionFormula>
    <errorDisplayField>Hosting_Date__c</errorDisplayField>
    <errorMessage
  >Hosting Date is required when Hosting Country is USA.</errorMessage>
</ValidationRule>
