<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Gold_Customer_Requires_Renewal_Date</fullName>
    <active>true</active>
    <errorConditionFormula
  >ISPICKVAL(Customer_Tier1__c, &quot;Silver&quot;) &amp;&amp; ISBLANK(RenewalNew_Date__c)</errorConditionFormula>
    <errorDisplayField>RenewalNew_Date__c</errorDisplayField>
    <errorMessage
  >Renewal Date is required when Customer Tier is Silver.</errorMessage>
</ValidationRule>
