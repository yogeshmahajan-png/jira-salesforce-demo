<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Other_PaymentType_Requires_PaymentDesc</fullName>
    <active>true</active>
    <errorConditionFormula
  >ISPICKVAL(Payment_Type__c, &quot;Other&quot;) &amp;&amp; ISBLANK(Payment_Desc__c)</errorConditionFormula>
    <errorDisplayField>Payment_Desc__c</errorDisplayField>
    <errorMessage
  >Payment Description field is required when Payment Type is Other.</errorMessage>
</ValidationRule>
