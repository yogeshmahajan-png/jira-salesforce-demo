<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Gold_Customer_Requires_Renewal_Date</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(ISPICKVAL(Customer_Tier__c, &quot;Gold&quot;), ISBLANK(Renewal_Date__c))</errorConditionFormula>
    <errorDisplayField>Renewal_Date__c</errorDisplayField>
    <errorMessage
  >Renewal Date field is required when Contact Tier is Gold.</errorMessage>
</ValidationRule>
