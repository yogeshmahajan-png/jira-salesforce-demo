{
  "name": "salesforce-jira-delivery",
  "displayName": "Salesforce Jira Delivery",
  "description": "Installs the Salesforce Jira Delivery Copilot agent and its portable workflow dependencies into any workspace.",
  "version": "1.0.0",
  "publisher": "yogeshmahajan-png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yogeshmahajan-png/jira-salesforce-demo.git",
    "directory": "vscode-salesforce-jira-delivery"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other",
    "Extension Packs"
  ],
  "keywords": [
    "salesforce",
    "jira",
    "copilot",
    "agent",
    "delivery"
  ],
  "extensionDependencies": [
    "GitHub.copilot-chat"
  ],
  "extensionPack": [
    "salesforce.salesforcedx-vscode",
    "redhat.vscode-xml"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "salesforceJiraDelivery.install",
        "title": "Salesforce Jira Delivery: Install Agent in Workspace",
        "category": "Salesforce Jira Delivery"
      },
      {
        "command": "salesforceJiraDelivery.openSidebar",
        "title": "Salesforce Jira Delivery: Open Sidebar",
        "category": "Salesforce Jira Delivery"
      },
      {
        "command": "salesforceJiraDelivery.setStory",
        "title": "Salesforce Jira Delivery: Select Jira Story",
        "category": "Salesforce Jira Delivery"
      },
      {
        "command": "salesforceJiraDelivery.startStory",
        "title": "Salesforce Jira Delivery: Start Story",
        "category": "Salesforce Jira Delivery"
      },
      {
        "command": "salesforceJiraDelivery.analyzeStory",
        "title": "Salesforce Jira Delivery: Analyze Story",
        "category": "Salesforce Jira Delivery"
      },
      {
        "command": "salesforceJiraDelivery.generateTests",
        "title": "Salesforce Jira Delivery: Generate Test Plan",
        "category": "Salesforce Jira Delivery"
      },
      {
        "command": "salesforceJiraDelivery.deploy",
        "title": "Salesforce Jira Delivery: Deploy to Development Org",
        "category": "Salesforce Jira Delivery",
        "enablement": "salesforceJiraDelivery.dryRun == false"
      },
      {
        "command": "salesforceJiraDelivery.runTests",
        "title": "Salesforce Jira Delivery: Run Tests",
        "category": "Salesforce Jira Delivery",
        "enablement": "salesforceJiraDelivery.dryRun == false"
      },
      {
        "command": "salesforceJiraDelivery.publish",
        "title": "Salesforce Jira Delivery: Publish Story",
        "category": "Salesforce Jira Delivery",
        "enablement": "salesforceJiraDelivery.dryRun == false"
      },
      {
        "command": "salesforceJiraDelivery.openPersonaMapping",
        "title": "Salesforce Jira Delivery: Open Persona Mapping",
        "category": "Salesforce Jira Delivery"
      },
      {
        "command": "salesforceJiraDelivery.gitStatus",
        "title": "Salesforce Jira Delivery: Show Git Status",
        "category": "Salesforce Jira Delivery"
      },
      {
        "command": "salesforceJiraDelivery.toggleDryRun",
        "title": "Salesforce Jira Delivery: Toggle Dry Run",
        "category": "Salesforce Jira Delivery"
      },
      {
        "command": "salesforceJiraDelivery.runDryRun",
        "title": "Salesforce Jira Delivery: Run Dry Run",
        "category": "Salesforce Jira Delivery",
        "enablement": "salesforceJiraDelivery.dryRun"
      },
      {
        "command": "salesforceJiraDelivery.showDryRunResult",
        "title": "Salesforce Jira Delivery: Show Dry Run Result",
        "category": "Salesforce Jira Delivery",
        "enablement": "salesforceJiraDelivery.hasDryRunResult"
      },
      {
        "command": "salesforceJiraDelivery.approveAndExecute",
        "title": "Salesforce Jira Delivery: Approve & Execute",
        "category": "Salesforce Jira Delivery",
        "enablement": "salesforceJiraDelivery.isAwaitingApproval"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "salesforceJiraDelivery",
          "title": "Salesforce Jira Delivery",
          "icon": "$(cloud-upload)"
        }
      ]
    },
    "views": {
      "salesforceJiraDelivery": [
        {
          "id": "salesforceJiraDelivery.sidebar",
          "name": "Delivery",
          "contextualTitle": "Salesforce Jira Delivery"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "salesforceJiraDelivery.setStory",
          "when": "view == salesforceJiraDelivery.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "salesforceJiraDelivery.startStory",
          "when": "view == salesforceJiraDelivery.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "salesforceJiraDelivery.approveAndExecute",
          "when": "view == salesforceJiraDelivery.sidebar && salesforceJiraDelivery.isAwaitingApproval",
          "group": "navigation@3"
        },
        {
          "command": "salesforceJiraDelivery.deploy",
          "when": "view == salesforceJiraDelivery.sidebar && salesforceJiraDelivery.dryRun == false && !salesforceJiraDelivery.isAwaitingApproval",
          "group": "navigation@3"
        },
        {
          "command": "salesforceJiraDelivery.runDryRun",
          "when": "view == salesforceJiraDelivery.sidebar && salesforceJiraDelivery.dryRun",
          "group": "navigation@3"
        },
        {
          "command": "salesforceJiraDelivery.showDryRunResult",
          "when": "view == salesforceJiraDelivery.sidebar && salesforceJiraDelivery.hasDryRunResult",
          "group": "navigation@4"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm test"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.2"
  }
}
