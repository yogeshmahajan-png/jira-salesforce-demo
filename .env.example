# Centralized Jira token auth for QA agent scripts
# Copy to ".env" locally and fill real values (do not commit .env).

QA_JIRA_BASE_URL=https://your-company.atlassian.net
QA_JIRA_EMAIL=your.email@company.com
QA_JIRA_API_TOKEN=your-jira-api-token

# Optional Salesforce org alias override for QA automation
SF_TARGET_ORG=CopilotJiraOrg
